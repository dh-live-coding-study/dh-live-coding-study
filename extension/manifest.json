{
  "manifest_version": 3,
  "name": "DH LeetCode submission collector",
  "version": "0.3.0",
  "minimum_chrome_version": "111",
  "description": "본인의 정답 Java 제출 원문을 스터디 저장소의 PR로 등록합니다.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "스터디 수집 설정"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
